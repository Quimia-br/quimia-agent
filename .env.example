# Conexão com o PostgreSQL (Aiven)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Conexão com o MongoDB (Atlas)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/quimia?retryWrites=true&w=majority

# Chave da Provider API para chat e juiz Jev
COMMANDCODE_API_KEY=sua_chave_commandcode_aqui
COMMANDCODE_BASE_URL=https://api.commandcode.ai/

# Chave Gemini usada apenas para embeddings do FAQ
GEMINI_API_KEY=sua_chave_gemini_aqui

# Banco vetorial do FAQ (Qdrant Cloud)
QDRANT_URL= https://aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_FAQ_COLLECTION=quimia_faq_chunks
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
FAQ_TOP_K=6
FAQ_SCORE_THRESHOLD=0.45

# Modelos CommandCode por perfil de agente; o juiz usa typesafe/jev-1.14.0
COMMANDCODE_FAST_MODEL=Qwen/Qwen3.8-Flash
COMMANDCODE_SPECIALIST_MODEL=Qwen/Qwen3.8-27B
COMMANDCODE_TIMEOUT_SECONDS=30
COMMANDCODE_MAX_RETRIES=2


# Origens web autorizadas, separadas por virgula. Nao use "*" com credenciais.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
