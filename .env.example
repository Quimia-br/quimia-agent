# Conexão com o PostgreSQL (Aiven)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Conexão com o MongoDB (Atlas)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/quimia?retryWrites=true&w=majority

# Chaves de API de IA
GEMINI_API_KEY=sua_chave_gemini_aqui
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# Modelos Groq por perfil de agente
GROQ_FAST_MODEL=qwen/qwen3.6-27b
GROQ_SPECIALIST_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

GROQ_SPECIALIST_MODEL=gemini-3.6-flash


# Origens web autorizadas, separadas por virgula. Nao use "*" com credenciais.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
